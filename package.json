{
  "name": "mailtu",
  "version": "1.1.0",
  "description": "Create mailto: links programmatically",
  "keywords": [
    "mailto"
  ],
  "license": "MIT",
  "author": "Alberto Rico",
  "repository": {
    "type": "git",
    "url": "https://github.com/alrico88/mailtu"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  }
}
